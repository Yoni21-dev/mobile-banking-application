rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow reading for duplicate phone/email check during registration
      allow read: if true;

      // Allow create for authenticated users only
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;

      // Transfer: balance-only increase by authenticated users
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['balance'])
          && request.resource.data.balance > resource.data.balance;
    }
  }
}